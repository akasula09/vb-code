Private Const GEMINI_API_KEY As String = _
    "AQ.Ab8RN6IbMHmUeJUHz6vyX0164K0NnOj4x7dpAlRlvSCLn5Jagg"

' Change this model name if Google changes availability.
Private Const GEMINI_MODEL As String = _
    "gemini-3.5-flash"

Private Const VK_CONTROL As Long = &H11
Private Const VK_LWIN As Long = &H5B
Private Const VK_R As Long = &H52


Private Const VK_SNAPSHOT As Byte = &H2C
Private Const KEYEVENTF_KEYUP As Long = &H2

Private watcherRunning As Boolean

'==================================================
' Start and stop macros
'==================================================

Public Sub StartGeminiHotkey()

    If GEMINI_API_KEY = "PASTE_YOUR_GEMINI_API_KEY_HERE" Then
        MsgBox "Paste your Gemini API key into GEMINI_API_KEY first.", _
               vbExclamation, "Missing API key"
        Exit Sub
    End If

    If watcherRunning Then
        MsgBox "The Gemini hotkey watcher is already running.", _
               vbInformation
        Exit Sub
    End If

    watcherRunning = True

    MsgBox _
        "Gemini hotkey watcher started." & vbCrLf & vbCrLf & _
        "Press Ctrl+Windows+R to send a prompt to Gemini." & _
        vbCrLf & _
        "Run StopGeminiHotkey to stop the watcher.", _
        vbInformation, _
        "Gemini Excel Assistant"

    WatchForHotkey

End Sub

Public Sub StopGeminiHotkey()

    watcherRunning = False
    Application.StatusBar = False

    MsgBox "Gemini hotkey watcher stopped.", vbInformation

End Sub

'==================================================
' Keyboard watcher
'==================================================

Private Sub WatchForHotkey()

    Dim oldHotkeyState As Boolean
    Dim newHotkeyState As Boolean

    Do While watcherRunning

        DoEvents

        newHotkeyState = _
            IsKeyDown(VK_CONTROL) And _
            IsKeyDown(VK_LWIN) And _
            IsKeyDown(VK_R)

        If newHotkeyState And Not oldHotkeyState Then
            HandleGeminiRequest
        End If

        oldHotkeyState = newHotkeyState

        'Approximately 10 checks per second.
        PauseMilliseconds 100

    Loop

    Application.StatusBar = False

End Sub

Private Function IsKeyDown(ByVal keyCode As Long) As Boolean

    IsKeyDown = ((GetAsyncKeyState(keyCode) And &H8000&) <> 0)

End Function

Private Sub PauseMilliseconds(ByVal milliseconds As Long)

    Dim startTime As Single
    startTime = Timer

    Do
        DoEvents

        If Timer < startTime Then
            startTime = startTime - 86400!
        End If

    Loop While ((Timer - startTime) * 1000!) < milliseconds

End Sub

'==================================================
' Prompt, screenshot, and Gemini request
'==================================================

Private Sub HandleGeminiRequest()

    Dim userPrompt As String
    Dim screenshotBase64 As String
    Dim answer As String
    Dim screenshotCaptured As Boolean

    userPrompt = InputBox( _
        "Enter your prompt for Gemini.", _
        "Gemini prompt")

    If Len(Trim$(userPrompt)) = 0 Then Exit Sub

    Application.StatusBar = "Capturing screen..."

    'Try to capture screenshot, but don't fail if it doesn't work
    screenshotCaptured = CaptureScreenToBase64(screenshotBase64)

    If screenshotCaptured Then
        Application.StatusBar = "Sending prompt with screenshot to Gemini..."
    Else
        Application.StatusBar = "Sending prompt to Gemini..."
    End If

    answer = SendToGemini(userPrompt, screenshotBase64)

    Application.StatusBar = False

    If Left$(answer, 6) = "ERROR:" Then
        ShowResponseWindow answer, "Gemini Error"
    Else
        ShowResponseWindow answer, "Gemini Response"
    End If

End Sub

'==================================================
' Capture the screen using Print Screen and Excel
'==================================================

Private Function CaptureScreenToBase64( _
    ByRef outputBase64 As String) As Boolean

    Dim oldSheet As Worksheet
    Dim temporarySheet As Worksheet
    Dim chartObject As chartObject
    Dim temporaryFile As String
    Dim imageBytes() As Byte
    Dim waitAttempts As Long
    Dim pasteSuccess As Boolean

    On Error GoTo CaptureFailed

    Set oldSheet = ActiveSheet

    Application.CutCopyMode = False
    Application.ScreenUpdating = False

    'Press the Windows Print Screen key.
    keybd_event VK_SNAPSHOT, 0, 0, 0
    keybd_event VK_SNAPSHOT, 0, KEYEVENTF_KEYUP, 0

    'Wait and retry if clipboard is empty
    waitAttempts = 0
    pasteSuccess = False
    
    Do While waitAttempts < 10 And Not pasteSuccess
        PauseMilliseconds 200
        DoEvents
        
        Set temporarySheet = ThisWorkbook.Worksheets.Add
        temporarySheet.Visible = xlSheetVeryHidden

        On Error Resume Next
        temporarySheet.Paste
        Err.Clear
        On Error GoTo 0
        
        If temporarySheet.Shapes.Count > 0 Or temporarySheet.ChartObjects.Count > 0 Then
            pasteSuccess = True
            Exit Do
        Else
            On Error Resume Next
            temporarySheet.Delete
            On Error GoTo 0
            waitAttempts = waitAttempts + 1
        End If
    Loop

    If Not pasteSuccess Then
        GoTo CaptureFailed
    End If

    On Error GoTo CaptureFailed

    Set chartObject = temporarySheet.ChartObjects.Add( _
        Left:=0, _
        Top:=0, _
        Width:=1200, _
        Height:=800)

    chartObject.Chart.Paste

    temporaryFile = Environ$("TEMP") & _
        "\excel_gemini_screen_" & _
        Format$(Now, "yyyymmdd_hhnnss") & ".png"

    chartObject.Chart.Export _
        Filename:=temporaryFile, _
        FilterName:="PNG"

    If Len(Dir$(temporaryFile)) = 0 Then
        GoTo CaptureFailed
    End If

    imageBytes = ReadBinaryFile(temporaryFile)
    outputBase64 = Base64Encode(imageBytes)

    On Error Resume Next

    Kill temporaryFile
    temporarySheet.Delete
    oldSheet.Activate
    Application.ScreenUpdating = True

    On Error GoTo 0

    CaptureScreenToBase64 = (Len(outputBase64) > 0)
    Exit Function

CaptureFailed:

    On Error Resume Next

    If Len(temporaryFile) > 0 Then Kill temporaryFile
    If Not temporarySheet Is Nothing Then temporarySheet.Delete
    If Not oldSheet Is Nothing Then oldSheet.Activate
    Application.ScreenUpdating = True

    On Error GoTo 0

    CaptureScreenToBase64 = False

End Function

'==================================================
' Send request to Gemini
'==================================================

Private Function SendToGemini( _
    ByVal userPrompt As String, _
    ByVal screenshotBase64 As String) As String

    Dim http As Object
    Dim endpoint As String
    Dim requestBody As String
    Dim responseBody As String
    Dim combinedPrompt As String

    On Error GoTo RequestFailed

    endpoint = _
        "https://generativelanguage.googleapis.com/v1beta/models/" & _
        GEMINI_MODEL & ":generateContent?key=" & _
        UrlEncode(GEMINI_API_KEY)

    combinedPrompt = _
        "You are assisting a user from Microsoft Excel." & _
        vbCrLf & vbCrLf & _
        userPrompt

    'Build request with screenshot if available, otherwise just text
    If Len(screenshotBase64) > 0 Then
        requestBody = _
            "{" & _
                """contents"":[" & _
                    "{" & _
                        """role"":""user""," & _
                        """parts"":[" & _
                            "{""text"":""" & _
                                JsonEscape(combinedPrompt) & _
                            """}," & _
                            "{""inline_data"":{" & _
                                """mime_type"":""image/png""," & _
                                """data"":""" & _
                                    screenshotBase64 & _
                                """" & _
                            "}}" & _
                        "]" & _
                    "}" & _
                "]," & _
                """generationConfig"":{" & _
                    """temperature"":0.2," & _
                    """maxOutputTokens"":4096" & _
                "}" & _
            "}"
    Else
        requestBody = _
            "{" & _
                """contents"":[" & _
                    "{" & _
                        """role"":""user""," & _
                        """parts"":[" & _
                            "{""text"":""" & _
                                JsonEscape(combinedPrompt) & _
                            """}" & _
                        "]" & _
                    "}" & _
                "]," & _
                """generationConfig"":{" & _
                    """temperature"":0.2," & _
                    """maxOutputTokens"":4096" & _
                "}" & _
            "}"
    End If

    Set http = CreateObject("WinHttp.WinHttpRequest.5.1")

    http.Open "POST", endpoint, False

    http.SetRequestHeader _
        "Content-Type", _
        "application/json"

    http.SetTimeouts _
        5000, _
        10000, _
        30000, _
        60000

    http.Send requestBody

    responseBody = http.responseText

    If http.Status < 200 Or http.Status >= 300 Then
        SendToGemini = _
            "ERROR: Gemini returned HTTP " & _
            http.Status & vbCrLf & responseBody
        Exit Function
    End If

    SendToGemini = ExtractGeminiText(responseBody)

    If Len(SendToGemini) = 0 Then
        SendToGemini = _
            "ERROR: Gemini returned no text." & vbCrLf & _
            responseBody
    End If

    Exit Function

RequestFailed:

    SendToGemini = "ERROR: " & Err.Description

End Function

'==================================================
' Extract Gemini text without an external JSON parser
'==================================================

Private Function ExtractGeminiText(ByVal json As String) As String

    Dim marker As String
    Dim startPosition As Long
    Dim endPosition As Long
    Dim rawText As String

    marker = """text"":"""

    startPosition = InStr(1, json, marker, vbTextCompare)

    If startPosition = 0 Then Exit Function

    startPosition = startPosition + Len(marker)

    endPosition = FindJsonStringEnd(json, startPosition)

    If endPosition = 0 Then Exit Function

    rawText = Mid$( _
        json, _
        startPosition, _
        endPosition - startPosition)

    ExtractGeminiText = JsonUnescape(rawText)

End Function

Private Function FindJsonStringEnd( _
    ByVal json As String, _
    ByVal startPosition As Long) As Long

    Dim i As Long
    Dim slashCount As Long
    Dim currentCharacter As String

    For i = startPosition To Len(json)

        currentCharacter = Mid$(json, i, 1)

        If currentCharacter = "\" Then

            slashCount = slashCount + 1

        ElseIf currentCharacter = """" Then

            If (slashCount Mod 2) = 0 Then
                FindJsonStringEnd = i
                Exit Function
            End If

            slashCount = 0

        Else

            slashCount = 0

        End If

    Next i

End Function

'==================================================
' Display response in a separate window (message box)
'==================================================

Private Sub ShowResponseWindow( _
    ByVal responseText As String, _
    ByVal windowTitle As String)

    MsgBox responseText, vbInformation, windowTitle

End Sub

'==================================================
' File and Base64 functions
'==================================================

Private Function ReadBinaryFile( _
    ByVal filePath As String) As Byte()

    Dim stream As Object
    Dim bytes() As Byte

    Set stream = CreateObject("ADODB.Stream")

    stream.Type = 1
    stream.Open
    stream.LoadFromFile filePath

    bytes = stream.Read

    stream.Close

    ReadBinaryFile = bytes

End Function

Private Function Base64Encode( _
    ByRef bytes() As Byte) As String

    Dim xml As Object
    Dim node As Object

    Set xml = CreateObject("MSXML2.DOMDocument.6.0")
    Set node = xml.createElement("base64")

    node.DataType = "bin.base64"
    node.nodeTypedValue = bytes

    Base64Encode = Replace(node.Text, vbCr, "")
    Base64Encode = Replace(Base64Encode, vbLf, "")

End Function

'==================================================
' JSON and URL encoding
'==================================================

Private Function JsonEscape(ByVal value As String) As String

    value = Replace(value, "\", "\\")
    value = Replace(value, """", "\""")
    value = Replace(value, vbCrLf, "\n")
    value = Replace(value, vbCr, "\n")
    value = Replace(value, vbLf, "\n")
    value = Replace(value, vbTab, "\t")

    JsonEscape = value

End Function

Private Function JsonUnescape(ByVal value As String) As String

    value = Replace(value, "\n", vbCrLf)
    value = Replace(value, "\r", vbCr)
    value = Replace(value, "\t", vbTab)
    value = Replace(value, "\""", """")
    value = Replace(value, "\\", "\")

    JsonUnescape = value

End Function

Private Function UrlEncode(ByVal value As String) As String

    Dim i As Long
    Dim character As String
    Dim characterCode As Long
    Dim output As String

    For i = 1 To Len(value)

        character = Mid$(value, i, 1)
        characterCode = AscW(character)

        If _
            (characterCode >= 48 And characterCode <= 57) Or _
            (characterCode >= 65 And characterCode <= 90) Or _
            (characterCode >= 97 And characterCode <= 122) Or _
            character = "-" Or _
            character = "_" Or _
            character = "." Or _
            character = "~" Then

            output = output & character

        Else

            output = output & "%" & _
                Right$("0" & Hex$(characterCode), 2)

        End If

    Next i

    UrlEncode = output

End Function
